# Copy to .env.local for local dev, and set the same vars in Vercel → Project → Settings → Environment Variables.

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# service_role secret key (server-only; NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App password gate. Leave empty to disable auth (public app).
APP_PASSWORD=change-me

# IBKR Flex Web Service (optional — enables one-click "IBKR sync" on the Import tab).
# Client Portal → Performance & Reports → Flex Queries → Flex Web Service Configuration.
# Use a Trade Confirmation Flex Query id for fast same-day sync.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
